@model BulkkyBook.DTOS.Book.CreateAuthorDto

@{
    ViewData["Title"] = "Thêm Tác giả Mới";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Thêm Tác giả Mới</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Thông tin Tác giả</h6>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="row">
                    <!-- Basic Information -->
                    <div class="col-md-8">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Name" class="form-label">Tên tác giả <span
                                        class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="Nhập tên tác giả">
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="Nhập email">
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Country" class="form-label">Quốc gia</label>
                                <input asp-for="Country" class="form-control" placeholder="Nhập quốc gia">
                                <span asp-validation-for="Country" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="BirthDate" class="form-label">Ngày sinh</label>
                                <input asp-for="BirthDate" class="form-control" type="date">
                                <span asp-validation-for="BirthDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ImageFile" class="form-label">Ảnh đại diện</label>
                                <input type="file" asp-for="ImageFile" class="form-control" accept="image/*">
                                <span asp-validation-for="ImageFile" class="text-danger"></span>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="Biography" class="form-label">Tiểu sử</label>
                                <textarea asp-for="Biography" class="form-control" rows="4"
                                    placeholder="Nhập tiểu sử tác giả"></textarea>
                                <span asp-validation-for="Biography" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Preview and Settings -->
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="mb-0">Xem trước</h6>
                            </div>
                            <div class="card-body text-center">
                                <div id="photoPreview" class="mb-3">
                                    <div class="bg-light d-flex align-items-center justify-content-center rounded-circle"
                                        style="width: 150px; height: 150px; margin: 0 auto;">
                                        <i class="fas fa-user fa-3x text-muted"></i>
                                    </div>
                                </div>
                                <h6 id="namePreview" class="text-muted">Tên tác giả</h6>
                                <p id="countryPreview" class="text-muted mb-0">Quốc gia</p>
                            </div>
                        </div>

                        <div class="card mt-3">
                            <div class="card-header">
                                <h6 class="mb-0">Cài đặt</h6>
                            </div>
                            <div class="card-body">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked>
                                    <label asp-for="IsActive" class="form-check-label">Kích hoạt tác giả</label>
                                </div>
                                <small class="form-text text-muted">Tác giả sẽ hiển thị trong hệ thống khi được kích
                                    hoạt</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Hủy
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Lưu tác giả
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Preview functionality
            $('#Name').on('input', function () {
                $('#namePreview').text($(this).val() || 'Tên tác giả');
            });

            $('#Country').on('input', function () {
                $('#countryPreview').text($(this).val() || 'Quốc gia');
            });

            // Preview khi nhập URL
            $('#PhotoUrl').on('input', function () {
                var url = $(this).val();
                if (url) {
                    $('#photoPreview').html('<img src="' + url + '" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover; margin: 0 auto;" onerror="this.parentElement.innerHTML=\'<div class=\\"bg-light d-flex align-items-center justify-content-center rounded-circle\\" style=\\"width: 150px; height: 150px; margin: 0 auto;\\"><i class=\\"fas fa-user fa-3x text-muted\\"></i></div>\'">');
                } else {
                    $('#photoPreview').html('<div class="bg-light d-flex align-items-center justify-content-center rounded-circle" style="width: 150px; height: 150px; margin: 0 auto;"><i class="fas fa-user fa-3x text-muted"></i></div>');
                }
            });

            // Preview khi chọn file
            $('input[type=file][name=ImageFile]').on('change', function (e) {
                var input = this;
                if (input.files && input.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#photoPreview').html('<img src="' + e.target.result + '" class="rounded-circle" style="width: 150px; height: 150px; object-fit: cover; margin: 0 auto;">');
                    }
                    reader.readAsDataURL(input.files[0]);
                }
            });
        });
    </script>
}