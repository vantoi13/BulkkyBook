@model IEnumerable<BulkkyBook.DTOS.Book.BookDto>

@{
    ViewData["Title"] = $"Sách của tác giả {ViewBag.AuthorName}";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-user me-2"></i>
            Sách của tác giả: @ViewBag.AuthorName
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Tổng cộng: @Model.Count() sách
            </h6>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <i class="fas fa-book fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">Không có sách nào</h5>
                    <p class="text-muted">Tác giả này chưa có sách nào trong hệ thống.</p>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var book in Model)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-4">
                                            @if (!string.IsNullOrEmpty(book.ImageUrl))
                                            {
                                                <img src="@book.ImageUrl" alt="Bìa sách" class="img-fluid rounded"
                                                    style="width: 100%; height: 120px; object-fit: cover;">
                                            }
                                            else
                                            {
                                                <div class="bg-light d-flex align-items-center justify-content-center rounded"
                                                    style="width: 100%; height: 120px;">
                                                    <i class="fas fa-book fa-2x text-muted"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-8">
                                            <h6 class="card-title text-primary mb-1">@book.Title</h6>
                                            <p class="card-text small text-muted mb-2">
                                                <i class="fas fa-tags me-1"></i>
                                                <a asp-controller="Category" asp-action="Details"
                                                    asp-route-id="@book.CategoryId"
                                                    class="text-decoration-none">@book.CategoryName</a>
                                            </p>
                                            <p class="card-text small mb-2">
                                                <i class="fas fa-calendar me-1"></i>
                                                @book.PublicationYear
                                            </p>
                                            <p class="card-text small mb-2">
                                                <i class="fas fa-dollar-sign me-1"></i>
                                                <span class="text-success fw-bold">@book.Price.ToString("N0") VNĐ</span>
                                            </p>
                                            <p class="card-text small mb-2">
                                                <i class="fas fa-boxes me-1"></i>
                                                <span class="badge @(book.StockQuantity > 0 ? "bg-success" : "bg-danger")">
                                                    @book.StockQuantity
                                                </span>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <code>@book.ISBN</code>
                                        </small>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-info"
                                                title="Chi tiết">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-warning"
                                                title="Sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>