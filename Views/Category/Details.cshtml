@model BulkkyBook.DTOS.Book.CategoryDto

@{
    ViewData["Title"] = "Chi tiết Thể loại";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Chi tiết Thể loại</h1>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                <i class="fas fa-edit"></i> Chỉnh sửa
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Category Icon and Basic Info -->
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Icon thể loại</h6>
                </div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.IconClass))
                    {
                        <i class="@Model.IconClass fa-5x text-primary mb-3"></i>
                    }
                    else
                    {
                        <i class="fas fa-tag fa-5x text-primary mb-3"></i>
                    }
                    <h3 class="text-primary">@Model.Name</h3>
                    @if (Model.DisplayOrder > 0)
                    {
                        <p class="text-muted mb-0">
                            <i class="fas fa-sort-numeric-up me-2"></i>
                            <span class="badge bg-info">Thứ tự: @Model.DisplayOrder</span>
                        </p>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Thao tác nhanh</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-controller="Book" asp-action="ByCategory" asp-route-categoryId="@Model.Id"
                            class="btn btn-outline-primary">
                            <i class="fas fa-book"></i> Xem sách trong thể loại
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                            <i class="fas fa-edit"></i> Chỉnh sửa thể loại
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Category Details -->
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Thông tin chi tiết</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tên thể loại</label>
                            <p class="form-control-plaintext">
                                <i
                                    class="@(string.IsNullOrEmpty(Model.IconClass) ? "fas fa-tag" : Model.IconClass) me-2"></i>
                                @Model.Name
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Thứ tự hiển thị</label>
                            <p class="form-control-plaintext">
                                <span class="badge bg-primary fs-6">@Model.DisplayOrder</span>
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Số sách</label>
                            <p class="form-control-plaintext">
                                <span class="badge bg-success fs-6">@Model.BookCount</span>
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Trạng thái</label>
                            <p class="form-control-plaintext">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Không hoạt động</span>
                                }
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Ngày tạo</label>
                            <p class="form-control-plaintext">
                                @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Cập nhật lần cuối</label>
                            <p class="form-control-plaintext">
                                @(Model.UpdatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")
                            </p>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-bold">Mô tả</label>
                                <div class="form-control-plaintext">
                                    <p class="mb-0">@Model.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- System Information -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Thông tin hệ thống</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">ID</label>
                            <p class="form-control-plaintext">
                                <code>@Model.Id</code>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Icon CSS Class</label>
                            <p class="form-control-plaintext">
                                @if (!string.IsNullOrEmpty(Model.IconClass))
                                {
                                    <code>@Model.IconClass</code>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có icon</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Statistics -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Thống kê</h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <i class="fas fa-book fa-2x text-primary mb-2"></i>
                                <h4 class="text-primary">@Model.BookCount</h4>
                                <p class="text-muted mb-0">Tổng số sách</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <i class="fas fa-sort-numeric-up fa-2x text-info mb-2"></i>
                                <h4 class="text-info">@Model.DisplayOrder</h4>
                                <p class="text-muted mb-0">Thứ tự hiển thị</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <i class="fas fa-calendar-alt fa-2x text-success mb-2"></i>
                                <h4 class="text-success">@Model.CreatedDate.ToString("dd/MM")</h4>
                                <p class="text-muted mb-0">Ngày tạo</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>