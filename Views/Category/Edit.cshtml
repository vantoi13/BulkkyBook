@model BulkkyBook.DTOS.Book.UpdateCategoryDto

@{
    ViewData["Title"] = "Chỉnh sửa Thể loại";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Chỉnh sửa Thể loại</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Thông tin Thể loại</h6>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input asp-for="Id" type="hidden" />
                
                <div class="row">
                    <!-- Basic Information -->
                    <div class="col-md-8">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Name" class="form-label">Tên thể loại <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="Nhập tên thể loại">
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DisplayOrder" class="form-label">Thứ tự hiển thị</label>
                                <input asp-for="DisplayOrder" class="form-control" type="number" min="1" placeholder="Nhập thứ tự">
                                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                                <small class="form-text text-muted">Số càng nhỏ càng hiển thị trước</small>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="IconClass" class="form-label">Icon CSS Class</label>
                                <input asp-for="IconClass" class="form-control" placeholder="fas fa-book">
                                <span asp-validation-for="IconClass" class="text-danger"></span>
                                <small class="form-text text-muted">Ví dụ: fas fa-book, fas fa-tag, fas fa-star</small>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="Description" class="form-label">Mô tả</label>
                                <textarea asp-for="Description" class="form-control" rows="4" 
                                          placeholder="Nhập mô tả về thể loại"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Preview and Settings -->
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="mb-0">Xem trước</h6>
                            </div>
                            <div class="card-body text-center">
                                <div id="iconPreview" class="mb-3">
                                    @if (!string.IsNullOrEmpty(Model.IconClass))
                                    {
                                                <i class="@Model.IconClass fa-3x text-primary"></i>
                                    }
                                    else
                                    {
                                                <i class="fas fa-tag fa-3x text-primary"></i>
                                    }
                                </div>
                                <h6 id="namePreview">@Model.Name</h6>
                                <p id="orderPreview" class="text-muted mb-0">Thứ tự: @Model.DisplayOrder</p>
                            </div>
                        </div>

                        <div class="card mt-3">
                            <div class="card-header">
                                <h6 class="mb-0">Cài đặt</h6>
                            </div>
                            <div class="card-body">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox">
                                    <label asp-for="IsActive" class="form-check-label">Kích hoạt thể loại</label>
                                </div>
                                <small class="form-text text-muted">Thể loại sẽ hiển thị trong hệ thống khi được kích hoạt</small>
                            </div>
                        </div>

                        <div class="card mt-3">
                            <div class="card-header">
                                <h6 class="mb-0">Icon phổ biến</h6>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-4 mb-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="setIcon('fas fa-book')">
                                            <i class="fas fa-book"></i>
                                        </button>
                                    </div>
                                    <div class="col-4 mb-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="setIcon('fas fa-tag')">
                                            <i class="fas fa-tag"></i>
                                        </button>
                                    </div>
                                    <div class="col-4 mb-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="setIcon('fas fa-star')">
                                            <i class="fas fa-star"></i>
                                        </button>
                                    </div>
                                    <div class="col-4 mb-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="setIcon('fas fa-heart')">
                                            <i class="fas fa-heart"></i>
                                        </button>
                                    </div>
                                    <div class="col-4 mb-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="setIcon('fas fa-fire')">
                                            <i class="fas fa-fire"></i>
                                        </button>
                                    </div>
                                    <div class="col-4 mb-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="setIcon('fas fa-gem')">
                                            <i class="fas fa-gem"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card mt-3">
                            <div class="card-header">
                                <h6 class="mb-0">Thông tin hệ thống</h6>
                            </div>
                            <div class="card-body">
                                <small class="text-muted">
                                    <strong>ID:</strong> @Model.Id<br>
                                    <strong>Ngày tạo:</strong> <span id="createdDate">Đang tải...</span><br>
                                    <strong>Cập nhật lần cuối:</strong> <span id="updatedDate">Đang tải...</span>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-12">
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Hủy
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Cập nhật
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
            <script>
                $(document).ready(function() {
                    // Preview functionality
                    $('#Name').on('input', function() {
                        $('#namePreview').text($(this).val() || 'Tên thể loại');
                    });

                    $('#DisplayOrder').on('input', function() {
                        $('#orderPreview').text('Thứ tự: ' + ($(this).val() || '1'));
                    });

                    $('#IconClass').on('input', function() {
                        var iconClass = $(this).val() || 'fas fa-tag';
                        $('#iconPreview').html('<i class="' + iconClass + ' fa-3x text-primary"></i>');
                    });
                });

                function setIcon(iconClass) {
                    $('#IconClass').val(iconClass);
                    $('#iconPreview').html('<i class="' + iconClass + ' fa-3x text-primary"></i>');
                }
            </script>
}