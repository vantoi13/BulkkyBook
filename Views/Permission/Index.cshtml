@model BulkkyBook.DTOS.Identity.PermissionViewModel
@{
    ViewData["Title"] = "Permissions";
}

<div class="container">
    <h2>Permissions for Role @Model.RoleName</h2>

    <form asp-action="SavePermissions" method="post">
        <input type="hidden" asp-for="RoleId" />
        <input type="hidden" asp-for="RoleName" />

        <div class="card">
            <div class="card-body">
                @for (var i = 0; i < Model.Functions!.Count; i++)
                {
                    <div class="mb-4">
                        <h5>@Model.Functions[i].Name</h5>
                        <input type="hidden" asp-for="@Model.Functions[i].Id" />
                        <input type="hidden" asp-for="@Model.Functions[i].Name" />

                        <div class="row">
                            @for (var j = 0; j < Model.Functions[i].Commands!.Count; j++)
                            {
                                <div class="col-md-2">
                                    <div class="form-check">
                                        <input type="hidden" asp-for="@Model.Functions[i].Commands[j].Id" />
                                        <input type="hidden" asp-for="@Model.Functions[i].Commands[j].Name" />
                                        <input class="form-check-input" type="checkbox"
                                            asp-for="@Model.Functions[i].Commands[j].IsSelected" />
                                        <label class="form-check-label">
                                            @Model.Functions[i].Commands[j].Name
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>

                    </div>
                }
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-controller="Role" asp-action="Index" class="btn btn-secondary">Back to Roles</a>
        </div>
    </form>
</div>