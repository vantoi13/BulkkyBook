<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BulkkyBook</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BulkkyBook.styles.css" asp-append-version="true" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <!-- Toastr -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BulkkyBook</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @using BulkkyBook.Repositories
                    @using BulkkyBook.Utils.Identity
                    @inject IUnitOfWork UnitOfWork
                    @{
                        var userRoles = User.Claims
                        .Where(x => x.Type == "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")
                        .Select(x => x.Value)
                        .ToList();

                        var hasUserPermission = userRoles.Any(role =>
                        {
                            var permissions = UnitOfWork.Permission.GetPermissionsByRole(role);
                            return permissions.Any(p =>
                                            p.FunctionId == Constants.Functions.SystemUser &&
                                            p.CommandId == Constants.Commands.Read);
                        });
                        var hasRolePermission = userRoles.Any(role =>
                        {
                            var permissions = UnitOfWork.Permission.GetPermissionsByRole(role);
                            return permissions.Any(p =>
                                            p.FunctionId == Constants.Functions.SystemRole &&
                                            p.CommandId == Constants.Commands.Read);
                        });

                        var hasAuthorPermission = userRoles.Any(role =>
                        {
                            var permissions = UnitOfWork.Permission.GetPermissionsByRole(role);
                            return permissions.Any(p =>
                                            p.FunctionId == Constants.Functions.SystemAuthor &&
                                            p.CommandId == Constants.Commands.Read);
                        });
                        var hasCategoryPermission = userRoles.Any(role =>
                        {
                            var permissions = UnitOfWork.Permission.GetPermissionsByRole(role);
                            return permissions.Any(p =>
                                            p.FunctionId == Constants.Functions.SystemCategory &&
                                            p.CommandId == Constants.Commands.Read);
                        });
                        var hasBookPermission = userRoles.Any(role =>
                        {
                            var permissions = UnitOfWork.Permission.GetPermissionsByRole(role);
                            return permissions.Any(p =>
                                            p.FunctionId == Constants.Functions.SystemBook &&
                                            p.CommandId == Constants.Commands.Read);
                        });
                    }
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home"
                                asp-action="Privacy">Privacy</a>
                        </li>
                        @if (hasRolePermission)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Role" asp-action="Index">Roles</a>
                            </li>
                        }
                        @if (hasUserPermission)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="Index">Users</a>
                            </li>
                        }
                        @if (hasAuthorPermission)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Author"
                                    asp-action="Index">Authors</a>
                            </li>
                        }
                        @if (hasCategoryPermission)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Category"
                                    asp-action="Index">Categories</a>
                            </li>
                        }
                        @if (hasBookPermission)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Book" asp-action="Index">Books</a>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - BulkkyBook - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- jQuery Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <!-- Toastr -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        // Toastr configuration
        toastr.options = {
            "closeButton": true,
            "debug": false,
            "newestOnTop": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "preventDuplicates": true,
            "onclick": null,
            "showDuration": "300",
            "hideDuration": "1000",
            "timeOut": "5000",
            "extendedTimeOut": "1000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };

        // Show toastr messages if available
        @if (TempData["Success"] != null)
            {
                <text>
                    toastr.success('@TempData["Success"]');
                </text>
        }
            @if (TempData["Error"] != null)
            {
                <text>
                    toastr.error('@TempData["Error"]');
                </text>
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
